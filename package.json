{
  "name": "emoji-kitchen-mcp",
  "version": "1.0.0",
  "packageManager": "pnpm@11.22.0",
  "description": "Model Context Protocol (MCP) server for Google Emoji Kitchen",
  "type": "module",
  "bin": {
    "emoji-kitchen-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caleb-collar/emoji-kitchen-mcp.git"
  },
  "homepage": "https://github.com/caleb-collar/emoji-kitchen-mcp#readme",
  "bugs": {
    "url": "https://github.com/caleb-collar/emoji-kitchen-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "emoji",
    "emoji-kitchen",
    "google-emoji-kitchen",
    "llm",
    "ai",
    "stickers"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "serve": "node dist/index.js --sse",
    "test": "vitest run",
    "prepare-data": "node scripts/download-metadata.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
